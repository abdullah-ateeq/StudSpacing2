    <!-- About Screen -->
    <string name="about_title">About StudSpacing</string>
    <string name="about_description">StudSpacing is a dedicated utility built specifically for framing carpenters, general contractors, and DIY woodworkers. It calculates the exact quantity and tape measure positions for wall studs based on total wall length and desired on-center spacing, accounting for drywall breaks and end studs.</string>
    <string name="about_framing_tip_title">Framing Tip (Drywall Alignment)</string>
    <string name="about_framing_tip_content">Standard 16\" on-center framing places the first field stud at 15 1/4\" on edge so that 48\" and 96\" drywall sheet edges break centered on the stud face.</string>
    <string name="about_privacy_policy">Privacy Policy</string>
    <string name="about_terms_of_service">Terms of Service</string>
    <string name="about_compliance_notice">StudSpacing operates 100% offline. No personally identifiable information, location data, or diagnostics are tracked or uploaded.</string>

    <!-- Privacy Policy & Terms Content (Google Play Compliance) -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_policy_content">StudSpacing (\"the App\") respects your privacy.\n\n1. Data Collection: The App does NOT collect, store, or transmit any personal data, location data, or device identifiers. All measurements and calculation history remain stored strictly on your local device.\n\n2. Third-Party Services: The App does not integrate third-party trackers, analytics SDKs, or advertising networks.\n\n3. Permissions: The App requires no dangerous system permissions.\n\n4. Contact: If you have questions regarding this policy, contact developer support via the Play Store listing.</string>
    <string name="terms_of_service_title">Terms of Service</string>
    <string name="terms_of_service_content">By using StudSpacing (\"the App\"), you agree to the following terms:\n\n1. Use License: The App provides framing estimations as an advisory tool for carpentry and DIY projects.\n\n2. Disclaimer: Always verify structural wall layouts against local building codes, structural engineering blueprints, and load-bearing requirements before cutting lumber or erecting framing.\n\n3. Limitation of Liability: The developer is not liable for structural defects, material miscalculations, or construction damages resulting from use of this application.</string>

